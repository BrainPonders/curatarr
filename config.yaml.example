# Curatarr configuration template.
#
# Runtime secrets may reference environment variables with ${ENV_NAME}.
# Startup fails if a referenced environment variable is missing.

users:
  admins:
    - 123456789
  standard:
    - 987654321

telegram:
  bot_token: ${CURATARR_TELEGRAM_BOT_TOKEN}
  # Viewing detection stays inactive until an admin sends /followups_here in the destination chat.
  viewing_scan_interval: 5m

# Staging acquisition and source workers. Keep disabled until write acceptance and
# retirement of competing native writers. This development runtime initializes
# schema 5 even when disabled; back up first. This is not the full cutover.
coordinator:
  enabled: false

# Required for --run-telegram movie search. Accepts a TMDB v3 API key or API Read Access Token.
tmdb:
  api_key: ${CURATARR_TMDB_API_KEY}

ryot:
  # Full GraphQL endpoint used by the existing read adapter; verify against your Ryot version.
  url: http://ryot:8000/backend/graphql
  api_key: ${CURATARR_RYOT_API_KEY}
  scan_interval: 30m
  collections:
    archived: Archived
    library: Library
    previously_acquired: Previously acquired
    deleted: Deleted
    radarr: Radarr
    sonarr: Sonarr

radarr:
  url: http://radarr:7878
  api_key: ${CURATARR_RADARR_API_KEY}
  default_profile: Movies > 4K EN+FR
  root_folder: /data/movies
  exclusion_sync: true

sonarr:
  url: http://sonarr:8989
  api_key: ${CURATARR_SONARR_API_KEY}
  default_profile: Shows > 4K EN+FR
  root_folder: /data/series
  exclusion_sync: true

jellyfin:
  # Optional direct viewing intake; separate from the removal draft token.
  # Set a random URL-safe token (43–128 characters) only during coordinated setup.
  # The account/threshold policy in Settings still defaults off. Pause Ryot's
  # direct Jellyfin integration before enabling this Curatarr policy.
  # viewing_webhook_token: ${CURATARR_JELLYFIN_VIEWING_WEBHOOK_TOKEN}
  url: http://jellyfin:8096
  api_key: ${CURATARR_JELLYFIN_API_KEY}
  reception_checks:
    enabled: true
    first_check_delay: 5m
    retry_interval: 15m
    timeout: 2h

policy:
  approvals:
    default_mode: confirm_user
    timeout_defaults:
      normal_user_media_decision: 24h
      admin_operational_issue: 24h
    actions:
      add_new_title: confirm_user
      reactivate_archived_title: confirm_user
      first_import_acquisition_sync: auto_apply
      jellyfin_reception_failure: confirm_admin
      destructive_drift_correction: confirm_admin
      weak_match_action: disabled

identity:
  weak_match_action: disabled

logging:
  level: INFO

# Repository diagnostics remain available; keep the household interface minimal.
maintenance:
  show_diagnostics: false
