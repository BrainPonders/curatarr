# owner: project maintainer
# date: 2026-03-23
# service: curatarr
# purpose: development compose example used by maintainer/dev-build.sh
# docs: maintainer/development/README.md, docker/compose/.env.dev.example
# deployment notes:
#   - The generated runtime copy is intended to live outside the repository.
#   - The development image currently supports config validation.
# history:
#   - 2026-03-10: Initialized generic template example.
#   - 2026-03-23: Adapted the example for the former Searcharr-nxg runtime.
#   - 2026-03-25: Updated notes for the active runtime.
#   - 2026-04-29: Reset to Curatarr scaffold baseline.

services:
  app:
    image: ${PROJECT_IMAGE}
    container_name: ${PROJECT_DEV_CONTAINER_NAME:-curatarr-dev}
    restart: unless-stopped

    env_file:
      - .env

    environment:
      CURATARR_CONFIG_FILE: /app/config.yaml

    volumes:
      - "${PROJECT_CONFIG_FILE:-./config.yaml}:/app/config.yaml:ro"
      - ./data:/app/data
