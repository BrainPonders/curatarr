# owner: project maintainer
# date: 2026-03-23
# service: curatarr
# purpose: production-oriented compose example for Curatarr
# docs: README.md, docker/compose/.env.example
# deployment notes:
#   - Provide a real config.yaml outside the repository before starting the container.
#   - Runtime workflows are still under development.
# history:
#   - 2026-03-10: Initialized generic template example.
#   - 2026-03-23: Adapted the example for the former Searcharr-nxg runtime.
#   - 2026-03-25: Updated notes for the active Telegram runtime.
#   - 2026-04-29: Reset to Curatarr scaffold baseline.

services:
  app:
    image: ${PROJECT_IMAGE}
    container_name: ${PROJECT_CONTAINER_NAME:-curatarr}
    restart: unless-stopped

    env_file:
      - .env

    environment:
      CURATARR_CONFIG_FILE: /app/config.yaml

    volumes:
      - "${PROJECT_CONFIG_FILE:-./config.yaml}:/app/config.yaml:ro"
      - ./data:/app/data
